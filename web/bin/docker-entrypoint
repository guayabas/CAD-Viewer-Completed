#!/bin/bash -e

# Before starting the server: create or migrate the database, then add the sample part if it is
# missing (db/seeds.rb is safe to run on every boot).
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
